{
  "manifest_version": 3,
  "name": "Passtore",
  "version": "0.1.0",
  "description": "Autofill y guardado de contraseñas desde tu vault local Passtore.",
  "permissions": ["nativeMessaging", "activeTab", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Passtore",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
